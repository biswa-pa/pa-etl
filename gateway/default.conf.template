# PA ETL gateway. The portal is on port 80. Cube, Prefect, Airbyte and ClickHouse
# each have their own port, and the gateway adds the PA ETL look on the way through.
# Upgrading the upstream image does not remove that look.
#
#   80    portal          (host 8080)
#   8081  Prefect
#   8082  Airbyte
#   8083  Cube
#   8084  ClickHouse

resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade { default upgrade; "" close; }

# Airbyte's ingress only accepts requests whose Origin is its own address.
map $http_origin $pa_airbyte_origin { default ${AIRBYTE_ORIGIN}; "" ""; }

server {
  listen 80 default_server;
  server_name ${PA_ETL_PORTAL_HOST};

  root /usr/share/nginx/html;
  index index.html;

  location = /config.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"brand":"PA ETL","prefect":"${PA_ETL_PREFECT_URL}","airbyte":"${PA_ETL_AIRBYTE_URL}","cube":"${PA_ETL_CUBE_URL}","clickhouse":"${PA_ETL_CLICKHOUSE_URL}"}';
  }

  location = /status/prefect {
    set $up http://prefect-server:4200;
    proxy_pass $up/api/health;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }
  location = /status/airbyte {
    set $up http://${AIRBYTE_UPSTREAM};
    proxy_pass $up/api/v1/health;
    proxy_set_header Host ${AIRBYTE_HOST_HEADER};
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }
  location = /status/cube {
    set $up http://${CUBE_UPSTREAM};
    proxy_pass $up/readyz;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }
  location = /status/clickhouse {
    set $up http://${CLICKHOUSE_UPSTREAM};
    proxy_pass $up/ping;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }

  location /__pa/ { alias /brand/; add_header Cache-Control "no-cache"; }
  location = /favicon.ico { alias /brand/icon.png; types { } default_type image/png; }
}

server {
  listen 80;
  listen 8081;
  server_name ${PA_ETL_PREFECT_HOST};

  location /__pa/ { alias /brand/; add_header Cache-Control "no-cache"; }
  location / {
    include /etc/nginx/pa-etl-prefect-auth.conf;
    include /etc/nginx/pa-etl-brand-prefect.conf;
    set $up http://prefect-server:4200;
    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }
}

server {
  listen 80;
  listen 8082;
  server_name ${PA_ETL_AIRBYTE_HOST};

  location /__pa/ { alias /brand/; add_header Cache-Control "no-cache"; }
  location / {
    include /etc/nginx/pa-etl-brand-airbyte.conf;
    set $up http://${AIRBYTE_UPSTREAM};
    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host ${AIRBYTE_HOST_HEADER};
    proxy_set_header Origin $pa_airbyte_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 600s;
    client_max_body_size 100m;
  }
}

server {
  listen 8083 default_server;
  server_name _;

  location /__pa/ { alias /brand/; add_header Cache-Control "no-cache"; }
  location / {
    include /etc/nginx/pa-etl-brand-cube.conf;
    set $up http://${CUBE_UPSTREAM};
    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }
}

server {
  listen 8084 default_server;
  server_name _;

  location /__pa/ { alias /brand/; add_header Cache-Control "no-cache"; }
  location / {
    include /etc/nginx/pa-etl-brand-clickhouse.conf;
    set $up http://${CLICKHOUSE_UPSTREAM};
    proxy_pass $up;
    proxy_http_version 1.1;
    proxy_set_header Host localhost;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
  }
}
