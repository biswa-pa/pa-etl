# Copy to .env. Every value is optional.

# Where people open PA ETL. Local default shown; the three names all point at the gateway.
PA_ETL_PORT=8080
PA_ETL_BIND=0.0.0.0
PA_ETL_PORTAL_HOST=etl.localhost
PA_ETL_PREFECT_HOST=pipeline.localhost
PA_ETL_AIRBYTE_HOST=connecter.localhost
PA_ETL_PORTAL_URL=http://etl.localhost:8080
# Each product has its own port on the gateway. The official app stays private
# behind that port, so upgrading its image does not drop the PA ETL look.
PA_ETL_PREFECT_PORT=8081
PA_ETL_AIRBYTE_PORT=8082
PA_ETL_CUBE_PORT=8083
PA_ETL_CLICKHOUSE_PORT=8084
PA_ETL_PREFECT_URL=http://localhost:8081
PA_ETL_AIRBYTE_URL=http://localhost:8082
PA_ETL_CUBE_URL=http://localhost:8083
PA_ETL_CLICKHOUSE_URL=http://localhost:8084/play

# Where the gateway reaches the official images inside this Compose project.
# Airbyte is the self-hosted abctl install on the host. The other three are
# the clickhouse, cube and prefect-server services below.
CUBE_UPSTREAM=cube:4000
CLICKHOUSE_UPSTREAM=clickhouse:8123
CLICKHOUSE_TAG=latest
CUBE_TAG=latest
CLICKHOUSE_USER=analytics_admin
CLICKHOUSE_PASSWORD=localdev
CLICKHOUSE_DB=sl_test
CUBEJS_API_SECRET=local-cube-secret

# Prefect has no login of its own. Set both to put a password on the Prefect UI.
PA_ETL_PREFECT_USER=
PA_ETL_PREFECT_PASSWORD=

# Database password for Prefect (only reachable inside the compose network).
POSTGRES_PASSWORD=pa-etl-change-me

# Airbyte (installed with scripts/airbyte.sh). Credentials come from
# `scripts/airbyte.sh credentials`; flows use them to start syncs.
AIRBYTE_URL=http://host.docker.internal:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Image names and versions.
PA_IMAGE_PREFIX=ghcr.io/biswa-pa/pa-etl
PA_VERSION=latest
# Official Prefect image. `3-latest` moves forward; the gateway keeps the PA ETL look.
PREFECT_TAG=3-latest
# Airbyte chart version for a new install. Branding is added by the gateway, so
# this can follow Airbyte's own release. Leave AIRBYTE_BRANDED unset (0).
AIRBYTE_TAG=2.3.0
